<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Utos.Workflow</PackageId>
    <RootNamespace>Utos.Workflow</RootNamespace>
    <Description>Utos workflow format types (Utos.Workflows.V1): Workflow, WorkflowBundle, activities and related messages. Generated from the Utos API specification. Shared by daemon implementers and callers.</Description>
    <PackageTags>utos;workflow;protobuf;grpc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <!-- RFC 8785 (JCS) canonicalization for the content-digest helper (Digest/). -->
    <PackageReference Include="jsoncanonicalizer" />
  </ItemGroup>

  <!--
    Hand-written source: the content-digest helper (Digest/) and the spec primitives the protos
    cannot express — semantic versions, canonical identity, reference parsing, and the fixed
    vocabularies (Spec/). Kept OUTSIDE Generated/ so protoc regeneration and the CI drift guard
    never touch them. EnableDefaultCompileItems=false (see Directory.Build.props) means these
    must be added explicitly.
  -->
  <ItemGroup>
    <Compile Include="Digest\**\*.cs" />
    <Compile Include="Spec\**\*.cs" />
  </ItemGroup>

  <!-- Messages only (no services in Utos.Workflows.V1). Regenerated in-place into the committed Generated/ folder. -->
  <ItemGroup>
    <Protobuf Include="..\..\proto\workflow\v1\*.proto"
              ProtoRoot="..\..\proto"
              GrpcServices="None"
              OutputDir="Generated"
              CompileOutputs="true" />
  </ItemGroup>

  <!-- Ship the proto + changelog as inert reference content (NOT contentFiles). -->
  <ItemGroup>
    <None Include="..\..\proto\workflow\**\*.proto" Pack="true" PackagePath="proto\workflow\" Visible="false" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="docs\" Visible="false" />
  </ItemGroup>

</Project>
