<Project>

  <!-- Shared settings for all SDK packages. -->
  <PropertyGroup>
    <!--
      net10.0, not netstandard2.0.

      .NET Standard is a specification rather than a runtime: a list of APIs a library promises to
      stick to, so it can run on any implementation of that list. It existed to bridge a split —
      .NET Framework, .NET Core, Mono, Xamarin — that .NET 5 ended. Microsoft stopped evolving it
      at 2.1 and says to target a concrete framework unless you need .NET Framework.

      netstandard2.0 buys exactly one thing: consumers on .NET Framework 4.x. Nothing else — every
      modern runtime reads net10.0 happily. We have no such consumer: the daemon, the CLI and the
      hub are all .NET 10, and a Framework app could not use Utos.Daemon.Client anyway, since the
      gRPC transport needs .NET Core 3.0 or later.

      What it cost while it lasted: its API surface is frozen at roughly 2017, so hand-written code
      here needed shims for `record`/`init`, KeyValuePair deconstruction, [GeneratedRegex],
      IReadOnlySet, index-from-end, and System.Text.Json as a package. Worse, IsAotCompatible does
      not work on netstandard2.0 (NETSDK1210) — so the AOT analyzer could not run on the very
      assemblies the NativeAOT `utos` binary links, and an AOT regression was only discoverable by
      publishing the CLI. It runs here now.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!--
      The CLI publishes NativeAOT and links these packages, so a dependency that resolves types by
      reflection at run time breaks it. Enabled here rather than per-project so the analyzer covers
      every package, and a regression is a build warning rather than something the CLI discovers
      at publish time.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!--
      Generated code lives in a committed Generated/ folder inside each project.
      Grpc.Tools adds the generated .cs to @(Compile) itself, so the default
      **/*.cs glob is disabled to avoid compiling them twice. There is no
      hand-written .cs in these packages.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Deterministic, source-navigable builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Symbol package (.snupkg) so consumers can step into generated source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Shared package metadata. Version is supplied by the release pipeline (-p:Version=). -->
    <Authors>Utos</Authors>
    <Company>Utos</Company>
    <Product>Utos</Product>
    <Copyright>Copyright (c) Utos</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/utos/sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/utos/sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated protobuf code has no XML doc comments; don't fail/spam on that. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- README + LICENSE packed into every package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
